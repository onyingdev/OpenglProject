{
  "backend": "opengl",
  "window": {
    "width": 1920,
    "height": 1080,
    "title": "OpenGL",
    "mode": "windowed",
    "resize": "free",
    "vsync": false,
    "glMajor": 3,
    "glMinor": 3
  },
  "render": {
    "internalWidth": 1920,
    "internalHeight": 1080,
    "antialiasing": "fxaa",
    "msaaSamples": 2,
    "debugColliders": false,
    "gamma": 2.2,
    "tonemap": "aces",
    "exposure": 1.0,
    "skybox": {
      "enabled": true,
      "faces": [
        "assets/textures/studio_light/px.png",
        "assets/textures/studio_light/nx.png",
        "assets/textures/studio_light/py.png",
        "assets/textures/studio_light/ny.png",
        "assets/textures/studio_light/pz.png",
        "assets/textures/studio_light/nz.png"
      ]
    }
  },
  "profiler": {
    "cpu": false,
    "gpu": false,
    "detail": false,
    "reportEvery": 60,
    "physics": {
      "timings": true,
      "solver": false,
      "print": false
    }
  }
}

{
  "backend": "opengl",
  "window": {
    "width": 1920,
    "height": 1080,
    "title": "OpenGL",
    "mode": "windowed",
    "resize": "locked",
    "vsync": false,
    "glMajor": 3,
    "glMinor": 3
  },
  "render": {
    "internalWidth": 1920,
    "internalHeight": 1080,
    "antialiasing": "fxaa",
    "msaaSamples": 2,
    "debugColliders": false
  },
  "profiler": {
    "cpu": false,
    "gpu": false,
    "detail": false,
    "reportEvery": 60,
    "physics": {
      "timings": false,
      "solver": false,
      "print": false
    }
  }
}

{
  "backend": "opengl",
  "window": {
    "width": 2560,
    "height": 1440,
    "title": "OpenGL",
    "mode": "windowed",
    "resize": "free",
    "vsync": true,
    "glMajor": 3,
    "glMinor": 3
  },
  "render": {
    "internalWidth": 2560,
    "internalHeight": 1440,
    "antialiasing": "none",
    "msaaSamples": 16,
    "debugColliders": false,
    "gamma": 2.2,
    "tonemap": "aces",
    "exposure": 1.0,
    "skybox": {
      "enabled": false,
      "drawBackground": true,
      "faces": [
        "assets/textures/studio_light/px.png",
        "assets/textures/studio_light/nx.png",
        "assets/textures/studio_light/py.png",
        "assets/textures/studio_light/ny.png",
        "assets/textures/studio_light/pz.png",
        "assets/textures/studio_light/nz.png"
      ]
    }
  },
  "profiler": {
    "cpu": false,
    "gpu": false,
    "detail": false,
    "reportEvery": 60,
    "physics": {
      "timings": false,
      "solver": false,
      "print": false
    }
  }
}
